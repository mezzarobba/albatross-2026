{
    "name": "ALBATROSS-2026",
    "image": "ghcr.io/rprebet/albatross-2026:latest",
    "remoteUser": "vscode",
    "containerEnv": {
        "JULIA_DEPOT_PATH": "/usr/local/julia-depot"
    },
    "postAttachCommand": "julia --project=. -e 'using Pluto, AlgebraicSolving, Plots, IJulia' && bash start-pluto.sh",
    "forwardPorts": [1234],
    "portsAttributes": {
        "1234": {
            "label": "Pluto",
            "onAutoForward": "openPreview"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "julialang.language-julia",
                "ms-toolsai.jupyter",
                "ms-toolsai.jupyter-renderers"
            ],
            "settings": {
                "chat.sendElementsToChat.enabled": false,
                "markdown.preview.security.level": "allow-insecure-local-content",
                "extensions.ignoreRecommendations": true
            }
        }
    }
}
